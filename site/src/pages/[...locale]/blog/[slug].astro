---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import Painting from "../../../components/Painting.astro";
import { paintingFor } from "../../../lib/paintings";
import BlogCard from "../../../components/BlogCard.astro";
import BlogToc from "../../../components/BlogToc.astro";
import UBadge from "@nuxt/ui/components/Badge.vue";
import UButton from "@nuxt/ui/components/Button.vue";
import { categoriesOf, formatDate, loadBlog, morePosts } from "../../../lib/blog";
import { absoluteUrl, breadcrumbs, organization } from "../../../lib/seo";
import { site } from "../../../site";
import { getI18n, localizedStaticPaths } from "../../../i18n";

export const getStaticPaths = () =>
  localizedStaticPaths(async (locale) => {
    const { posts, categories } = await loadBlog(locale);
    return posts.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, categories, more: morePosts(entry, posts) },
    }));
  });
const { t, path: to, sitePath, locale } = getI18n(Astro.url);
const { entry, categories, more } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const postCategories = categoriesOf(entry, categories);
const path = sitePath(`/blog/${entry.id}/`);
const cover = entry.data.coverImage?.src;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.pubDate,
    dateModified: entry.data.pubDate,
    url: absoluteUrl(path),
    mainEntityOfPage: absoluteUrl(path),
    image: absoluteUrl(cover ?? site.ogImage),
    keywords: entry.data.tags.length > 0 ? entry.data.tags.join(", ") : undefined,
    author: { "@type": "Organization", name: site.name, url: absoluteUrl(sitePath("/")) },
    publisher: organization(),
  },
  breadcrumbs([{ name: t("common.home"), path: sitePath("/") }, { name: t("blog.title"), path: sitePath("/blog/") }, { name: entry.data.title, path }]),
];
---
<Base title={entry.data.title} description={entry.data.description} type="article" published={entry.data.pubDate} image={cover} imageAlt={entry.data.coverAlt} jsonLd={jsonLd}>
  <div class="page mx-auto w-full max-w-5xl pb-section">
    <article class="pt-10 md:pt-16" data-pagefind-body>
      <div data-pagefind-ignore>
        <UButton color="neutral" variant="outline" size="sm" class="rounded-full" icon="i-hugeicons-arrow-left-02" label={t("blog.title")} to={to("/blog/")} />
      </div>
      <div
        class:list={[
          "mt-8",
          toc.length > 1 && "lg:grid lg:grid-cols-[minmax(0,38rem)_12rem] lg:items-start lg:justify-between lg:gap-10",
        ]}
      >
        <div class="min-w-0 max-w-measure">
          <div class="rise flex flex-wrap items-center gap-x-4 gap-y-1">
            <time class="label" datetime={entry.data.pubDate}>{formatDate(entry.data.pubDate, locale)}</time>
            {postCategories.map((category) => (
              <UBadge as="a" color="neutral" variant="outline" class="relative z-10" href={to(`/blog/categories/${category.id}/`)} label={category.title} />
            ))}
          </div>
          <h1 class="rise mt-4 text-title tracking-display text-ink">{entry.data.title}</h1>
          <p class="rise-2 mt-6 text-body text-muted">{entry.data.description}</p>
          <div class="rise-3 mt-10 overflow-hidden rounded-md bg-sand">
            {entry.data.coverImage ? (
              <Image class="aspect-16/9 w-full object-cover" src={entry.data.coverImage} alt={entry.data.coverAlt!} widths={[800, 1200, 1600]} sizes="(min-width: 64rem) 38rem, 100vw" loading="eager" />
            ) : (
              <div class="relative aspect-16/9 w-full"><Painting id={paintingFor(entry.id)} eager /></div>
            )}
          </div>
          {toc.length > 1 && <BlogToc headings={toc} variant="inline" class="mt-10 lg:hidden" />}
          <div class="prose mt-12 max-w-none prose-img:h-auto prose-img:max-w-full prose-img:rounded-md"><Content /></div>
          {entry.data.tags.length > 0 && (
            <ul class="mt-10 flex flex-wrap gap-2" aria-label={t("blog.tags")}>
              {entry.data.tags.map((tag) => <li><UBadge color="neutral" variant="soft" class="text-muted" label={`#${tag}`} /></li>)}
            </ul>
          )}
        </div>
        {toc.length > 1 && <BlogToc headings={toc} variant="rail" class="pt-1" />}
      </div>
    </article>
    {more.length > 0 && (
      <section class="mt-section border-t border-line pt-12" aria-labelledby="keep-reading">
        <h2 class="text-heading tracking-tight text-ink" id="keep-reading">{t("blog.keepReading")}</h2>
        <div class="mt-6">
          {more.map((post) => <BlogCard post={post} categories={categories} level={3} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  // Marks each "On this page" link for the heading being read.
  const track = () => {
    const tocs = [...document.querySelectorAll<HTMLElement>("[data-toc]")];
    if (tocs.length === 0 || !("IntersectionObserver" in window)) return;
    const links = new Map<string, HTMLAnchorElement[]>();
    for (const toc of tocs) {
      for (const link of toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")) {
        const id = decodeURIComponent(link.hash.slice(1));
        links.set(id, [...(links.get(id) ?? []), link]);
      }
    }
    const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id);
        const current = headings.find((heading) => visible.has(heading.id));
        if (!current) return;
        for (const [id, anchors] of links) {
          for (const anchor of anchors) anchor.setAttribute("aria-current", String(id === current.id));
        }
      },
      { rootMargin: "-15% 0px -65% 0px" },
    );
    for (const heading of headings) observer.observe(heading);
    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
  };
  document.addEventListener("astro:page-load", track);
</script>
