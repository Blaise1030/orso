---
import Base from "../../../layouts/Base.astro";
import BlogCard from "../../../components/BlogCard.astro";
import BlogFeatured from "../../../components/BlogFeatured.astro";
import BlogFilters from "../../../components/BlogFilters.astro";
import PagefindSearch from "../../../components/PagefindSearch.astro";
import { loadBlog, searchText } from "../../../lib/blog";
import { breadcrumbs } from "../../../lib/seo";
import { getI18n, localeStaticPaths } from "../../../i18n";

export const getStaticPaths = localeStaticPaths;
const { t, locale, sitePath } = getI18n(Astro.url);
const { posts, categories } = await loadBlog(locale);
const [lead, ...rest] = posts;
---
<Base
  title={t("blog.title")}
  description={t("blog.description")}
  jsonLd={[{ "@context": "https://schema.org", "@type": "WebPage", name: t("blog.title") }, breadcrumbs([{ name: t("common.home"), path: sitePath("/") }, { name: t("blog.title"), path: sitePath("/blog/") }])]}
>
  <div class="page mx-auto w-full max-w-5xl pb-section">
    <h1 class="sr-only">{t("blog.title")}</h1>
    {posts.length === 0 ? (
      <p class="py-16 text-muted">{t("blog.empty")}</p>
    ) : (
      <>
        <BlogFeatured post={lead} categories={categories} search={searchText(lead, categories)} />
        <div class="flex flex-col gap-4 border-t border-line pt-8 md:flex-row md:items-center md:justify-between">
          <h2 class="text-heading tracking-tight text-ink">{t("blog.recent")}</h2>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
            <BlogFilters categories={categories} />
            <PagefindSearch bundle="blog" placeholder={t("blog.search")} class="w-full sm:w-72" />
          </div>
        </div>
        {rest.length > 0 && (
          <div class="mt-6" data-blog-grid>
            {rest.map((post) => <BlogCard post={post} categories={categories} search={searchText(post, categories)} />)}
          </div>
        )}
      </>
    )}
  </div>
</Base>
