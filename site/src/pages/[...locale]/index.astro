---
import Bands from "../../components/sections/Bands.astro";
import Faq from "../../components/sections/Faq.astro";
import Hero from "../../components/sections/Hero.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import Logos from "../../components/sections/Logos.astro";
import Proof from "../../components/sections/Proof.astro";
import Setup from "../../components/sections/Setup.astro";
import Base from "../../layouts/Base.astro";
import { organization, website } from "../../lib/seo";
import { getI18n, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { t } = getI18n(Astro.url);
---

<Base description={t("site.description")} jsonLd={[website(), organization()]} header={false}>
  <div class="mx-auto w-full max-w-5xl">
    <Hero />
    <Logos />
    <HowItWorks />
    <Setup />
    <Bands />
    <Proof />
    <Faq />
  </div>
</Base>
