---
// Documentation layout for every Help page: quiet nav | centred content.
import type { BreadcrumbItem, NavigationMenuItem } from "@nuxt/ui";
import UBreadcrumb from "@nuxt/ui/components/Breadcrumb.vue";
import PagefindSearch from "./PagefindSearch.astro";
import HelpNav from "./vue/HelpNav.vue";
import { getI18n } from "../i18n";
import { loadHelp, type Doc } from "../lib/help";

interface Props {
  /** Site path of this page, e.g. "/help/" or "/help/add-images/", to mark it current. */
  current: string;
  /** Trail above the title; the last item is this page and is not linked. */
  crumbs?: { label: string; href?: string }[];
}
const { current, crumbs = [] } = Astro.props;
const { t, path, locale } = getI18n(Astro.url);
const { categories, docs } = await loadHelp(locale);
const shown = categories.filter((category) => category.docs.length > 0);

const docPath = (doc: Doc) => `/help/${doc.id}/`;
const link = (label: string, target: string): NavigationMenuItem => ({ label, to: path(target), active: target === current });
/** Overview, then one collapsible group per category; every category starts open. */
const navItems: NavigationMenuItem[] = [
  link(t("help.overview"), "/help/"),
  ...shown.map((category) => {
    const categoryPath = `/help/category/${category.id}/`;
    return {
      label: category.title,
      defaultOpen: true,
      children: [link(t("help.overview"), categoryPath), ...category.docs.map((doc) => link(doc.data.title, docPath(doc)))],
    };
  }),
];
const breadcrumb: BreadcrumbItem[] = crumbs.map((crumb) => ({ label: crumb.label, to: crumb.href ? path(crumb.href) : undefined }));
---

<div class="page mx-auto w-full max-w-5xl gap-10 pb-section lg:grid lg:grid-cols-[14rem_minmax(0,1fr)]">
  <aside class="min-w-0" aria-label={t("help.navLabel")} data-pagefind-ignore>
    <div class="flex flex-col gap-4 py-2 lg:sticky lg:top-header lg:max-h-[calc(100dvh-var(--spacing-header))] lg:overflow-y-auto lg:py-4">
      {docs.length > 0 && <PagefindSearch bundle="help" placeholder={t("help.search")} />}
      <HelpNav client:load items={navItems} labels={{ browse: t("help.browseHelp"), nav: t("help.title") }} />
    </div>
  </aside>

  <div class="min-w-0 pt-4 pb-10 md:pt-6 md:pb-14">
    <div class="mx-auto max-w-measure">
      {breadcrumb.length > 0 && (
        <UBreadcrumb
          items={breadcrumb}
          separator-icon="i-hugeicons-arrow-right-01"
          data-pagefind-ignore
          ui={{ link: "text-small font-normal text-muted hover:text-ink", linkLabel: "text-small", separatorIcon: "size-3.5 text-muted" }}
        />
      )}
      <slot />
    </div>
  </div>
</div>
