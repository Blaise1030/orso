---
import UBadge from "@nuxt/ui/components/Badge.vue";
import UCard from "@nuxt/ui/components/Card.vue";
import Painting from "../Painting.astro";
import AppShot from "../vue/AppShot.vue";
import BranchPickerMock from "../vue/BranchPickerMock.vue";
import SlashMenuMock from "../vue/SlashMenuMock.vue";
import { appShot } from "../../lib/appShots";
import { getI18n } from "../../i18n";
import type { PaintingId } from "../../lib/paintings";

const { t, group } = getI18n(Astro.url);
const branchPicker = group<{
  trigger: string;
  searchPlaceholder: string;
  liveLabel: string;
  liveDescription: string;
  draftLabel: string;
  draftDescription: string;
  reviewLabel: string;
  reviewDescription: string;
  reviewBadge: string;
  newChangeLabel: string;
}>("home.bento.cells.branches.picker");

type ShotCell = {
  key: "git" | "preview";
  painting: PaintingId;
  shot: Awaited<ReturnType<typeof appShot>>;
};

const shotCells: ShotCell[] = [
  { key: "git", painting: "bridge", shot: await appShot("ops-history") },
  { key: "preview", painting: "rocks", shot: await appShot("ops-preview") },
];

const stack = [
  { name: "Astro", file: "astro" },
  { name: "Markdown", file: "markdown" },
  { name: "GitHub", file: "github" },
];

const cardUi = { header: "p-0 sm:p-0", body: "px-4 pt-5 pb-4 sm:px-4 sm:pt-5 sm:pb-4" };
const cellBorder =
  "border-b border-line sm:odd:border-r lg:border-r lg:border-b-0 lg:[&:nth-child(-n+3)]:border-b lg:[&:nth-child(3n)]:border-r-0";
---

<section class="mx-auto max-w-7xl border-x border-b border-line" id="capabilities" aria-label={t("home.bento.label")}>
  <ul class="grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
    <li class={cellBorder}>
      <UCard variant="ghost" class="h-full rounded-none bg-transparent p-2" ui={cardUi}>
        <div slot="header" class="relative aspect-4/3 overflow-hidden rounded-md border border-line">
          <Painting id={shotCells[0].painting} />
          <div class="absolute inset-0 bg-night/20" aria-hidden="true"></div>
          <div class="relative flex size-full items-center justify-center p-3 md:p-4">
            <AppShot
              shot={shotCells[0].shot}
              alt={t("home.bento.cells.git.alt")}
              sizes="(min-width: 80rem) 25rem, (min-width: 48rem) 50vw, 100vw"
              class="h-full max-h-full w-auto max-w-full"
            />
          </div>
        </div>
        <h3 class="text-heading tracking-normal text-ink">{t("home.bento.cells.git.title")}</h3>
        <p class="mt-1 text-small leading-6 text-muted">{t("home.bento.cells.git.body")}</p>
      </UCard>
    </li>

    <li class={cellBorder}>
      <UCard variant="ghost" class="h-full rounded-none bg-transparent p-2" ui={cardUi}>
        <div slot="header" class="relative aspect-4/3 overflow-hidden rounded-md border border-line bg-sand p-3 md:p-4">
          <SlashMenuMock
            client:visible
            title={t("home.bento.cells.editor.demoTitle")}
            body={t("home.bento.cells.editor.demoBody")}
          />
        </div>
        <h3 class="text-heading tracking-normal text-ink">{t("home.bento.cells.editor.title")}</h3>
        <p class="mt-1 text-small leading-6 text-muted">{t("home.bento.cells.editor.body")}</p>
      </UCard>
    </li>

    <li class={cellBorder}>
      <UCard variant="ghost" class="h-full rounded-none bg-transparent p-2" ui={cardUi}>
        <div slot="header" class="relative aspect-4/3 overflow-hidden rounded-md border border-line">
          <Painting id={shotCells[1].painting} />
          <div class="absolute inset-0 bg-night/20" aria-hidden="true"></div>
          <div class="relative flex size-full items-center justify-center p-3 md:p-4">
            <AppShot
              shot={shotCells[1].shot}
              alt={t("home.bento.cells.preview.alt")}
              sizes="(min-width: 80rem) 25rem, (min-width: 48rem) 50vw, 100vw"
              class="h-full max-h-full w-auto max-w-full"
            />
          </div>
        </div>
        <h3 class="text-heading tracking-normal text-ink">{t("home.bento.cells.preview.title")}</h3>
        <p class="mt-1 text-small leading-6 text-muted">{t("home.bento.cells.preview.body")}</p>
      </UCard>
    </li>

    <li class={cellBorder}>
      <UCard variant="ghost" class="h-full rounded-none bg-transparent p-2" ui={cardUi}>
        <div slot="header" class="relative aspect-4/3 overflow-hidden rounded-md border border-line bg-sand p-2 md:p-3">
          <BranchPickerMock
            client:visible
            trigger={branchPicker.trigger}
            search-placeholder={branchPicker.searchPlaceholder}
            live-label={branchPicker.liveLabel}
            live-description={branchPicker.liveDescription}
            draft-label={branchPicker.draftLabel}
            draft-description={branchPicker.draftDescription}
            review-label={branchPicker.reviewLabel}
            review-description={branchPicker.reviewDescription}
            review-badge={branchPicker.reviewBadge}
            new-change-label={branchPicker.newChangeLabel}
          />
        </div>
        <h3 class="text-heading tracking-normal text-ink">{t("home.bento.cells.branches.title")}</h3>
        <p class="mt-1 text-small leading-6 text-muted">{t("home.bento.cells.branches.body")}</p>
      </UCard>
    </li>

    <li class={cellBorder}>
      <UCard variant="ghost" class="h-full rounded-none bg-transparent p-2" ui={cardUi}>
        <div slot="header" class="relative flex aspect-4/3 items-center justify-center overflow-hidden rounded-md border border-line bg-sand">
          <ul class="flex flex-wrap items-center justify-center gap-5 px-4">
            {stack.map((logo) => (
              <li class="inline-flex h-8 items-center">
                <img
                  src={`/logos/${logo.file}.svg`}
                  alt={logo.name}
                  width="120"
                  height="32"
                  class="logo-on-light h-auto max-h-8 w-auto max-w-[6rem] object-contain"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  src={`/logos/${logo.file}-on-dark.svg`}
                  alt=""
                  width="120"
                  height="32"
                  class="logo-on-dark h-auto max-h-8 w-auto max-w-[6rem] object-contain"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
              </li>
            ))}
          </ul>
        </div>
        <h3 class="text-heading tracking-normal text-ink">{t("home.bento.cells.stack.title")}</h3>
        <p class="mt-1 text-small leading-6 text-muted">{t("home.bento.cells.stack.body")}</p>
      </UCard>
    </li>

    <li class="border-b border-line last:border-b-0 sm:odd:border-r lg:border-r-0 lg:border-b-0">
      <UCard variant="ghost" class="h-full rounded-none bg-transparent p-2" ui={cardUi}>
        <div slot="header" class="relative flex aspect-4/3 items-center justify-center overflow-hidden rounded-md border border-line bg-sand">
          <UBadge color="neutral" variant="outline" size="lg" label={t("home.bento.cells.open.badge")} />
        </div>
        <h3 class="text-heading tracking-normal text-ink">{t("home.bento.cells.open.title")}</h3>
        <p class="mt-1 text-small leading-6 text-muted">{t("home.bento.cells.open.body")}</p>
      </UCard>
    </li>
  </ul>
</section>
