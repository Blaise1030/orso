---
import UButton from "@nuxt/ui/components/Button.vue";
import Icon from "../Icon.astro";
import DownloadButton from "../vue/DownloadButton.vue";
import { getI18n } from "../../i18n";

const { t, group } = getI18n(Astro.url);

const facts = [
  { title: t("home.cta.facts.free.title"), detail: t("home.cta.facts.free.detail"), icon: "scale" as const },
  { title: t("home.cta.facts.repo.title"), detail: t("home.cta.facts.repo.detail"), icon: "file-text" as const },
  { title: t("home.cta.facts.static.title"), detail: t("home.cta.facts.static.detail"), icon: "globe" as const },
];
---

<section class="page py-section" id="cta">
  <div class="grid md:grid-cols-12">
    <div class="px-0 pb-8 md:col-span-7 md:pr-10 md:pb-10">
      <h2 class="max-w-xl text-title tracking-display text-ink">{t("home.cta.title")}</h2>
    </div>
    <div class="border-t border-line pt-8 md:col-span-5 md:border-t-0 md:border-l md:pt-0 md:pl-10 md:pb-10">
      <p class="max-w-measure text-muted">
        {t("home.cta.body")}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <DownloadButton client:visible labels={group("download")} />
        <UButton color="neutral" variant="outline" size="lg" label={t("home.cta.github")} to="https://github.com/Blaise1030/cms" rel="noopener noreferrer" />
      </div>
      <p class="mt-2 text-small text-muted">{t("home.cta.platforms")}</p>
    </div>
  </div>

  <ul class="mt-10 grid divide-y divide-line border-t border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
    {facts.map((fact) => (
      <li class="py-6 sm:px-6 md:px-8 md:py-8 first:sm:pl-0 last:sm:pr-0">
        <span class="flex size-9 items-center justify-center rounded-md border border-line bg-surface-raised text-ink">
          <Icon name={fact.icon} class="size-5" />
        </span>
        <p class="mt-4 text-small font-medium text-ink">{fact.title}</p>
        <p class="mt-1 text-small text-muted">{fact.detail}</p>
      </li>
    ))}
  </ul>
</section>
