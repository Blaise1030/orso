---
import UButton from "@nuxt/ui/components/Button.vue";
import DownloadButton from "../vue/DownloadButton.vue";
import { getI18n } from "../../i18n";

const { t, group } = getI18n(Astro.url);
---

<section class="page py-section" id="cta">
  <div class="flex max-w-measure flex-col gap-4">
    <h2 class="text-title tracking-display text-ink">{t("home.cta.title")}</h2>
    <p class="text-muted">{t("home.cta.body")}</p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <DownloadButton client:visible labels={group("download")} />
      <UButton
        color="neutral"
        variant="outline"
        size="lg"
        label={t("home.cta.github")}
        to="https://github.com/Blaise1030/cms"
        rel="noopener noreferrer"
      />
    </div>
    <p class="text-small text-muted">{t("home.cta.platforms")}</p>
  </div>
</section>
