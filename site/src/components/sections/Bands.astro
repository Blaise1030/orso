---
import BentoBranchTile from "../vue/BentoBranchTile.vue";
import { getI18n } from "../../i18n";

const { t } = getI18n(Astro.url);

const stack = [
  { name: "Astro", file: "astro" },
  { name: "Markdown", file: "markdown" },
  { name: "GitHub", file: "github" },
];
---

<section class="py-section" id="bands" aria-label={t("home.bands.label")}>
  <div class="page space-y-20 md:space-y-28">
    <article>
      <h2 class="max-w-measure text-heading tracking-normal text-ink">{t("home.bands.git.title")}</h2>
      <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.bands.git.body")}</p>
      <p class="mt-8 max-w-md text-title tracking-tight text-ink">{t("home.bands.git.statement")}</p>
      <p class="mt-4 font-mono text-label text-muted">{t("home.bands.git.statementMeta")}</p>
    </article>

    <article>
      <h2 class="max-w-measure text-heading tracking-normal text-ink">{t("home.bands.branches.title")}</h2>
      <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.bands.branches.body")}</p>
      <figure class="mt-8 m-0 max-w-xl overflow-hidden border border-line bg-surface">
        <div class="relative aspect-4/3 w-full overflow-hidden md:aspect-video">
          <BentoBranchTile
            client:visible
            trigger={t("home.bands.branches.picker.trigger")}
            live-label={t("home.bands.branches.picker.liveLabel")}
            draft-label={t("home.bands.branches.picker.draftLabel")}
            draft-meta={t("home.bands.branches.picker.draftDescription")}
          />
        </div>
      </figure>
    </article>

    <article>
      <h2 class="max-w-measure text-heading tracking-normal text-ink">{t("home.bands.stack.title")}</h2>
      <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.bands.stack.body")}</p>
      <ul class="mt-8 grid list-none grid-cols-3 gap-x-8 gap-y-6 p-0">
        {stack.map((logo) => (
          <li class="flex h-8 items-center">
            <picture>
              <source srcset={`/logos/${logo.file}-on-dark.svg`} media="(prefers-color-scheme: dark)" />
              <img
                src={`/logos/${logo.file}.svg`}
                alt={logo.name}
                width="120"
                height="32"
                class="h-7 w-auto max-w-full object-contain object-left"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
