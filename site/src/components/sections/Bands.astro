---
import BentoBranchTile from "../vue/BentoBranchTile.vue";
import { getI18n } from "../../i18n";

const { t } = getI18n(Astro.url);

const stack = [
  { name: "Astro", file: "astro" },
  { name: "Markdown", file: "markdown" },
  { name: "GitHub", file: "github" },
];
---

<section
  class="mx-auto max-w-7xl border-x border-b border-line"
  id="bands"
  aria-label={t("home.bands.label")}
>
  <article class="grid border-b border-line md:grid-cols-12">
    <div class="flex flex-col justify-center px-6 py-10 md:col-span-5 md:border-r md:border-line md:px-10 md:py-14">
      <h2 class="text-heading tracking-normal text-ink">{t("home.bands.git.title")}</h2>
      <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.bands.git.body")}</p>
    </div>
    <div class="flex min-h-64 flex-col justify-end bg-sand px-6 py-8 md:col-span-7 md:min-h-[22rem] md:px-10 md:py-12">
      <p class="max-w-md text-title tracking-tight text-ink">{t("home.bands.git.statement")}</p>
      <p class="mt-4 font-mono text-label text-muted">{t("home.bands.git.statementMeta")}</p>
    </div>
  </article>

  <article class="grid border-b border-line md:grid-cols-12">
    <div class="order-2 flex min-h-64 items-center justify-center bg-sand p-4 md:order-1 md:col-span-7 md:min-h-[22rem] md:p-8">
      <div class="relative aspect-4/3 w-full max-w-xl overflow-hidden rounded-md border border-line">
        <BentoBranchTile
          client:visible
          trigger={t("home.bands.branches.picker.trigger")}
          live-label={t("home.bands.branches.picker.liveLabel")}
          draft-label={t("home.bands.branches.picker.draftLabel")}
          draft-meta={t("home.bands.branches.picker.draftDescription")}
        />
      </div>
    </div>
    <div class="order-1 flex flex-col justify-center border-b border-line px-6 py-10 md:order-2 md:col-span-5 md:border-b-0 md:border-l md:border-line md:px-10 md:py-14">
      <h2 class="text-heading tracking-normal text-ink">{t("home.bands.branches.title")}</h2>
      <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.bands.branches.body")}</p>
    </div>
  </article>

  <article class="grid md:grid-cols-12">
    <div class="flex flex-col justify-center px-6 py-10 md:col-span-5 md:border-r md:border-line md:px-10 md:py-14">
      <h2 class="text-heading tracking-normal text-ink">{t("home.bands.stack.title")}</h2>
      <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.bands.stack.body")}</p>
    </div>
    <div class="flex min-h-48 items-center bg-sand px-6 py-10 md:col-span-7 md:min-h-[18rem] md:px-10">
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-6">
        {stack.map((logo) => (
          <li>
            <img
              src={`/logos/${logo.file}.svg`}
              alt={logo.name}
              width="120"
              height="32"
              class="logo-on-light h-auto max-h-8 w-auto max-w-[6.5rem] object-contain"
              loading="lazy"
              decoding="async"
            />
            <img
              src={`/logos/${logo.file}-on-dark.svg`}
              alt=""
              width="120"
              height="32"
              class="logo-on-dark h-auto max-h-8 w-auto max-w-[6.5rem] object-contain"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
          </li>
        ))}
      </ul>
    </div>
  </article>
</section>
