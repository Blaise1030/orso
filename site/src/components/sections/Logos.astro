---
import { getI18n } from "../../i18n";

const { t } = getI18n(Astro.url);

const logos = [
  { name: "Astro", file: "astro" },
  { name: "Markdown", file: "markdown" },
  { name: "GitHub", file: "github" },
  { name: "Claude", file: "claude" },
  { name: "Cursor", file: "cursor" },
  { name: "Codex", file: "codex" },
];
---

<section class="mx-auto max-w-7xl border-x border-b border-line py-8 md:py-10" id="logos" aria-label={t("home.logos.label")}>
  <div class="page flex flex-col gap-5 md:flex-row md:items-center md:justify-between md:gap-10">
    <p class="shrink-0 text-small text-muted">{t("home.logos.intro")}</p>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-4 md:justify-end md:gap-x-8">
      {logos.map((logo) => (
        <li class="inline-flex h-6 items-center justify-center">
          <img
            src={`/logos/${logo.file}.svg`}
            alt={logo.name}
            width="120"
            height="32"
            class="logo-on-light h-auto max-h-5 w-auto max-w-[5.5rem] object-contain object-center"
            loading="lazy"
            decoding="async"
          />
          <img
            src={`/logos/${logo.file}-on-dark.svg`}
            alt=""
            width="120"
            height="32"
            class="logo-on-dark h-auto max-h-5 w-auto max-w-[5.5rem] object-contain object-center"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
