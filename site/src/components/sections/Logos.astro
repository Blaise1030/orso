---
import { getI18n } from "../../i18n";

const { t } = getI18n(Astro.url);

const logos = [
  { name: "Astro", file: "astro" },
  { name: "Markdown", file: "markdown" },
  { name: "GitHub", file: "github" },
  { name: "Claude", file: "claude" },
  { name: "Cursor", file: "cursor" },
  { name: "Codex", file: "codex" },
];
---

<section class="py-section" id="logos" aria-labelledby="logos-title">
  <div class="page">
    <h2 id="logos-title" class="max-w-measure text-heading tracking-normal text-ink">
      {t("home.logos.title")}
    </h2>
    <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.logos.body")}</p>
    <ul class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5" aria-label={t("home.logos.label")}>
      {logos.map((logo) => (
        <li class="inline-flex h-7 items-center justify-center">
          <img
            src={`/logos/${logo.file}.svg`}
            alt={logo.name}
            width="120"
            height="32"
            class="logo-on-light h-auto max-h-6 w-auto max-w-[6rem] object-contain object-center"
            loading="lazy"
            decoding="async"
          />
          <img
            src={`/logos/${logo.file}-on-dark.svg`}
            alt=""
            width="120"
            height="32"
            class="logo-on-dark h-auto max-h-6 w-auto max-w-[6rem] object-contain object-center"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
