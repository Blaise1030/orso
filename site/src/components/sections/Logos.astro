---
import { getI18n } from "../../i18n";

const { t } = getI18n(Astro.url);

const logos = [
  { name: "Astro", file: "astro" },
  { name: "Markdown", file: "markdown" },
  { name: "GitHub", file: "github" },
  { name: "Claude", file: "claude" },
  { name: "Cursor", file: "cursor" },
  { name: "Codex", file: "codex" },
];
---

<section class="py-section" id="logos" aria-labelledby="logos-title">
  <div class="page">
    <h2 id="logos-title" class="max-w-measure text-heading tracking-normal text-ink">
      {t("home.logos.title")}
    </h2>
    <p class="mt-3 max-w-measure text-small leading-6 text-muted">{t("home.logos.body")}</p>
    {/* One <picture> per mark so light/dark variants never share a flex slot (that caused overlap). */}
    <ul
      class="mt-8 grid list-none grid-cols-2 gap-x-8 gap-y-6 p-0 sm:grid-cols-3 md:grid-cols-6"
      aria-label={t("home.logos.label")}
    >
      {logos.map((logo) => (
        <li class="flex h-8 items-center">
          <picture>
            <source srcset={`/logos/${logo.file}-on-dark.svg`} media="(prefers-color-scheme: dark)" />
            <img
              src={`/logos/${logo.file}.svg`}
              alt={logo.name}
              width="120"
              height="32"
              class="h-6 w-auto max-w-full object-contain object-left"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </li>
      ))}
    </ul>
  </div>
</section>
