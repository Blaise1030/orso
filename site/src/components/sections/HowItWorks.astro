---
import Painting from "../Painting.astro";
import AgentComposerMock from "../vue/AgentComposerMock.vue";
import BentoHeroEditor from "../vue/BentoHeroEditor.vue";
import BentoPreviewTile from "../vue/BentoPreviewTile.vue";
import { getI18n } from "../../i18n";

const { t, group } = getI18n(Astro.url);

const editor = group<{ demoTitle: string }>("home.howItWorks.steps.edit.editor");
const preview = group<{
  desktopLabel: string;
  mobileLabel: string;
  pageTitle: string;
}>("home.howItWorks.steps.preview.frame");
const composer = group<{
  userMessage: string;
  assistantMessage: string;
  prompt: string;
  placeholder: string;
  pageContext: string;
  modelLabel: string;
  askLabel: string;
  sendLabel: string;
  attachLabel: string;
}>("home.howItWorks.steps.agent.composer");

const steps = [
  {
    key: "edit",
    painting: "bridge" as const,
    mock: "editor" as const,
  },
  {
    key: "preview",
    painting: "toledo" as const,
    mock: "preview" as const,
  },
  {
    key: "agent",
    painting: "rocks" as const,
    mock: "agent" as const,
  },
];
---

<section class="mx-auto max-w-7xl border-x border-b border-line pt-section" id="how-it-works">
  <div class="page">
    <div class="w-full md:max-w-3/4">
      <h2 class="text-title tracking-display text-ink">{t("home.howItWorks.title")}</h2>
      <p class="mt-4 max-w-measure text-muted">{t("home.howItWorks.body")}</p>
    </div>
  </div>

  <ol class="mt-12 border-t border-line">
    {steps.map((step, index) => (
      <li class="grid border-b border-line last:border-b-0 md:grid-cols-12">
        <div class="flex flex-col justify-center border-b border-line px-6 py-10 md:col-span-5 md:border-r md:border-b-0 md:px-10 md:py-14">
          <p class="font-mono text-label text-muted">{String(index + 1).padStart(2, "0")}</p>
          <h3 class="mt-4 text-heading tracking-normal text-ink">
            {t(`home.howItWorks.steps.${step.key}.title`)}
          </h3>
          <p class="mt-3 max-w-measure text-small leading-6 text-muted">
            {t(`home.howItWorks.steps.${step.key}.body`)}
          </p>
        </div>
        <div class="relative min-h-72 overflow-hidden md:col-span-7 md:min-h-[28rem]">
          <Painting id={step.painting} />
          <div class="absolute inset-0 bg-night/20" aria-hidden="true"></div>
          <div class="relative flex size-full items-center justify-center p-3 sm:p-5 md:p-8">
            {step.mock === "editor" && (
              <div class="relative aspect-4/3 w-full max-w-xl overflow-hidden rounded-md border border-line">
                <BentoHeroEditor
                  client:visible
                  title={editor.demoTitle}
                  slash-hint="/"
                />
              </div>
            )}
            {step.mock === "preview" && (
              <div class="relative aspect-4/3 w-full max-w-xl overflow-hidden rounded-md border border-line">
                <BentoPreviewTile
                  client:visible
                  desktop-label={preview.desktopLabel}
                  mobile-label={preview.mobileLabel}
                  page-title={preview.pageTitle}
                />
              </div>
            )}
            {step.mock === "agent" && (
              <div class="relative flex aspect-4/3 w-full max-w-xl overflow-hidden rounded-md border border-line p-2 md:p-3">
                <AgentComposerMock
                  client:visible
                  user-message={composer.userMessage}
                  assistant-message={composer.assistantMessage}
                  prompt={composer.prompt}
                  placeholder={composer.placeholder}
                  page-context={composer.pageContext}
                  model-label={composer.modelLabel}
                  ask-label={composer.askLabel}
                  send-label={composer.sendLabel}
                  attach-label={composer.attachLabel}
                />
              </div>
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>
