---
import AgentComposerMock from "../vue/AgentComposerMock.vue";
import BentoHeroEditor from "../vue/BentoHeroEditor.vue";
import BentoPreviewTile from "../vue/BentoPreviewTile.vue";
import { getI18n } from "../../i18n";

const { t, group } = getI18n(Astro.url);

const editor = group<{ demoTitle: string }>("home.howItWorks.steps.edit.editor");
const preview = group<{
  desktopLabel: string;
  mobileLabel: string;
  pageTitle: string;
}>("home.howItWorks.steps.preview.frame");
const composer = group<{
  userMessage: string;
  assistantMessage: string;
  prompt: string;
  placeholder: string;
  pageContext: string;
  modelLabel: string;
  askLabel: string;
  sendLabel: string;
  attachLabel: string;
}>("home.howItWorks.steps.agent.composer");

const steps = [
  { key: "edit", mock: "editor" as const },
  { key: "preview", mock: "preview" as const },
  { key: "agent", mock: "agent" as const },
];
---

<section class="py-section" id="how-it-works">
  <div class="page">
    <div class="w-full md:max-w-3/4">
      <h2 class="text-title tracking-display text-ink">{t("home.howItWorks.title")}</h2>
      <p class="mt-4 max-w-measure text-muted">{t("home.howItWorks.body")}</p>
    </div>

    <ol class="mt-14 space-y-16 md:mt-16 md:space-y-24">
      {steps.map((step, index) => (
        <li class="grid items-center gap-8 md:grid-cols-12 md:gap-12">
          <div class="md:col-span-5">
            <p class="font-mono text-label text-muted">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-4 text-heading tracking-normal text-ink">
              {t(`home.howItWorks.steps.${step.key}.title`)}
            </h3>
            <p class="mt-3 max-w-measure text-small leading-6 text-muted">
              {t(`home.howItWorks.steps.${step.key}.body`)}
            </p>
          </div>
          <div class="md:col-span-7">
            {step.mock === "editor" && (
              <div class="relative aspect-4/3 w-full overflow-hidden rounded-md border border-line bg-sand shadow-raised">
                <BentoHeroEditor
                  client:visible
                  title={editor.demoTitle}
                  slash-hint="/"
                />
              </div>
            )}
            {step.mock === "preview" && (
              <div class="relative aspect-4/3 w-full overflow-hidden rounded-md border border-line bg-sand shadow-raised">
                <BentoPreviewTile
                  client:visible
                  desktop-label={preview.desktopLabel}
                  mobile-label={preview.mobileLabel}
                  page-title={preview.pageTitle}
                />
              </div>
            )}
            {step.mock === "agent" && (
              <div class="relative flex aspect-4/3 w-full overflow-hidden rounded-md border border-line bg-sand p-2 shadow-raised md:p-3">
                <AgentComposerMock
                  client:visible
                  user-message={composer.userMessage}
                  assistant-message={composer.assistantMessage}
                  prompt={composer.prompt}
                  placeholder={composer.placeholder}
                  page-context={composer.pageContext}
                  model-label={composer.modelLabel}
                  ask-label={composer.askLabel}
                  send-label={composer.sendLabel}
                  attach-label={composer.attachLabel}
                />
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
