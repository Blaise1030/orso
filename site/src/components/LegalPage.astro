---
// A legal page from `src/content/legal/en/<id>.md`, in the page's language when Crowdin has
// translated it. Replace the placeholder text with your own policy before launch.
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "./PageHeader.astro";
import { breadcrumbs } from "../lib/seo";
import { getLocalizedCollection } from "../lib/localized";
import { getI18n } from "../i18n";

interface Props {
  /** The entry id: "privacy" or "terms". */
  id: string;
}
const { t, date, locale, sitePath } = getI18n(Astro.url);
const entry = (await getLocalizedCollection("legal", locale)).find((page) => page.id === Astro.props.id);
if (!entry) throw new Error(`LegalPage: no src/content/legal/en/${Astro.props.id}.md`);
const { title, description, updated } = entry.data;
const { Content } = await render(entry);
---

<Base
  title={title}
  description={description}
  jsonLd={[
    { "@context": "https://schema.org", "@type": "WebPage", name: title, description, dateModified: updated },
    breadcrumbs([{ name: t("common.home"), path: sitePath("/") }, { name: title, path: sitePath(`/${entry.id}/`) }]),
  ]}
>
  <div class="page mx-auto w-full max-w-5xl pb-section">
    <PageHeader title={title} description={description} />
    <div class="mt-12 max-w-measure">
      <p class="rounded-md border-l-2 border-accent bg-mist px-5 py-4 text-small text-ink" role="note">
        {t("legal.placeholder")}
      </p>
      <p class="label mt-10">{t("legal.lastUpdated")} <time datetime={updated}>{date(updated, "long")}</time></p>
      <div class="prose mt-6 max-w-none"><Content /></div>
    </div>
  </div>
</Base>
