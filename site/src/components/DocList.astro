---
// Help article list: stacked hairline rows (title + description), whole row a link.
import { getI18n } from "../i18n";
import type { Doc } from "../lib/help";

interface Props {
  docs: Doc[];
}
const { docs } = Astro.props;
const { path } = getI18n(Astro.url);
---

<ul class="divide-y divide-line border-t border-line">
  {docs.map((doc) => (
    <li class="relative py-4">
      <a class="after:absolute after:inset-0" href={path(`/help/${doc.id}/`)}>
        <span class="block font-medium text-ink">{doc.data.title}</span>
        {doc.data.description && <span class="mt-1 block text-small text-muted">{doc.data.description}</span>}
      </a>
    </li>
  ))}
</ul>
