---
import type { MarkdownHeading } from "astro";
import TocCollapsible from "./vue/TocCollapsible.vue";
import { getI18n } from "../i18n";

interface Props {
  headings: MarkdownHeading[];
  /** `inline` is the collapsible under the lead; `rail` remains for any sticky column use. */
  variant: "rail" | "inline";
  /** Extra classes on the wrapper. */
  class?: string;
}
const { headings, variant, class: className } = Astro.props;
const { t } = getI18n(Astro.url);
const railLink =
  "block text-muted transition-colors duration-quick ease-gentle hover:text-ink aria-[current=true]:text-ink";
---

{variant === "rail" ? (
  <aside class:list={["hidden lg:block", className]}>
    <nav class="lg:sticky lg:top-28" aria-label={t("toc.title")} data-toc>
      <p class="text-small font-medium text-ink">{t("toc.title")}</p>
      <ul class="mt-3 flex flex-col gap-2 text-small">
        {headings.map((heading) => (
          <li>
            <a class:list={[railLink, heading.depth === 3 && "pl-3"]} href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
) : (
  <TocCollapsible client:idle class={className} title={t("toc.title")} headings={headings.map(({ depth, slug, text }) => ({ depth, slug, text }))} />
)}
