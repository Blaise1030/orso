---
import { Image } from "astro:assets";
import Painting from "./Painting.astro";
import { paintingFor } from "../lib/paintings";
import { getI18n } from "../i18n";
import UBadge from "@nuxt/ui/components/Badge.vue";
import { categoriesOf, formatDate, type BlogCategory, type Post } from "../lib/blog";

interface Props {
  post: Post;
  categories: BlogCategory[];
  /** Lower-case haystack used by the blog search. */
  search?: string;
}
const { post, categories, search } = Astro.props;
const postCategories = categoriesOf(post, categories);
const { path, locale } = getI18n(Astro.url);
---

<article
  class="group relative py-section"
  data-blog-item
  data-search={search}
>
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:gap-10">
    <div class="min-w-0 flex-1 overflow-hidden rounded-md bg-sand">
      {post.data.coverImage ? (
        <Image
          class="aspect-16/10 w-full object-cover"
          src={post.data.coverImage}
          alt={post.data.coverAlt!}
          widths={[400, 800, 1200]}
          sizes="(min-width: 64rem) 28rem, (min-width: 48rem) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="relative aspect-16/10 w-full">
          <Painting id={paintingFor(post.id)} eager />
        </div>
      )}
    </div>
    <div class="flex min-w-0 flex-1 flex-col gap-3">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <time class="label" datetime={post.data.pubDate}>{formatDate(post.data.pubDate, locale)}</time>
        {postCategories.map((category) => (
          <UBadge as="a" color="neutral" variant="outline" class="relative z-10" href={path(`/blog/categories/${category.id}/`)} label={category.title} />
        ))}
      </div>
      <h2 class="text-title tracking-display text-ink">
        <a class="after:absolute after:inset-0" href={path(`/blog/${post.id}/`)}>{post.data.title}</a>
      </h2>
      <p class="max-w-measure text-body text-muted">{post.data.description}</p>
    </div>
  </div>
</article>
