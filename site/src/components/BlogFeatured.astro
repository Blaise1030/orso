---
import { getI18n } from "../i18n";
import UBadge from "@nuxt/ui/components/Badge.vue";
import { categoriesOf, formatDate, type BlogCategory, type Post } from "../lib/blog";

interface Props {
  post: Post;
  categories: BlogCategory[];
  /** Lower-case haystack used by the blog search. */
  search?: string;
}
const { post, categories, search } = Astro.props;
const postCategories = categoriesOf(post, categories);
const { path, locale } = getI18n(Astro.url);
---

<article
  class="group relative py-section"
  data-blog-item
  data-search={search}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <time class="label" datetime={post.data.pubDate}>{formatDate(post.data.pubDate, locale)}</time>
    {postCategories.map((category) => (
      <UBadge as="a" color="neutral" variant="outline" class="relative z-10" href={path(`/blog/categories/${category.id}/`)} label={category.title} />
    ))}
  </div>
  <h2 class="mt-4 text-title tracking-display text-ink">
    <a class="after:absolute after:inset-0" href={path(`/blog/${post.id}/`)}>{post.data.title}</a>
  </h2>
  <p class="mt-4 max-w-measure text-body text-muted">{post.data.description}</p>
</article>
