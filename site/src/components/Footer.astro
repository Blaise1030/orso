---
// Site footer: wordmark, closing CTA, then link columns. Group and link data live in `src/site.ts`.
import BearMark from "./BearMark.astro";
import UButton from "@nuxt/ui/components/Button.vue";
import DownloadButton from "./vue/DownloadButton.vue";
import { getI18n } from "../i18n";
import { site, type FooterLink } from "../site";

const { t, path, group } = getI18n(Astro.url);
const external = (link: string) => /^https?:\/\//.test(link);
const navLink = (link: (typeof site.nav)[number]) => ({ label: t(`nav.${link.key}`), href: link.href });
const footerLink = (link: FooterLink) => ({
  label: t(`footer.links.${link.key}`),
  href: link.href,
});
const groups = [
  { title: "Product", links: site.nav.filter((link) => link.href.startsWith("#")).map(navLink) },
  { title: "Resources", links: site.nav.filter((link) => !link.href.startsWith("#")).map(navLink) },
  { title: "More", links: [site.footer.source, ...site.socials.filter((social) => social.href !== site.footer.source.href)].map(footerLink) },
  { title: "Legal", links: [...site.footer.links, site.footer.license].map(footerLink) },
]
  .map((group) => ({
    label: t(`footer.groups.${group.title as "Product" | "Resources" | "More" | "Legal"}`),
    links: [...group.links, ...(site.footer.extra[group.title] ?? []).map(footerLink)],
  }))
  .filter((group) => group.links.length > 0);
---

<footer class="relative mx-auto w-full max-w-5xl" id="site-footer">
  <div class="page pt-section pb-section">
    <a class="inline-flex items-center gap-2.5 text-ink" href={path("/")} aria-label={t("site.homeLabel", { name: site.name })}>
      <BearMark class="h-5 w-auto" />
      <span class="text-body font-medium tracking-tight">{site.name}</span>
    </a>

    <div class="mt-10 flex flex-col gap-4" id="cta">
      <h2 class="text-heading tracking-normal text-ink">{t("home.cta.title")}</h2>
      <p class="text-muted">{t("home.cta.body")}</p>
      <div id="get-orso" class="mt-2 flex flex-wrap items-center gap-3">
        <DownloadButton client:visible labels={group("download")} />
        <UButton
          color="neutral"
          variant="outline"
          size="lg"
          icon="i-hugeicons-github"
          label={t("home.cta.github")}
          to="https://github.com/Blaise1030/cms"
          rel="noopener noreferrer"
          target="_blank"
        />
      </div>
      <p class="text-small text-muted">{t("home.cta.platforms")}</p>
    </div>

    <nav class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4" aria-label={t("footer.label")}>
      {groups.map((group) => (
        <div>
          <p class="text-small font-medium text-ink">{group.label}</p>
          <ul class="mt-4 -ml-2.5 space-y-1 text-small text-muted">
            {group.links.map((link) => (
              <li>
                <UButton
                  color="neutral"
                  variant="ghost"
                  class="text-muted"
                  label={link.label}
                  to={path(link.href)}
                  rel={external(link.href) ? "noopener noreferrer" : undefined}
                />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
