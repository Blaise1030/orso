---
import PageHeader from "../../components/PageHeader.astro";
import Base from "../../layouts/Base.astro";
import { formatDate, loadPosts } from "../../lib/posts";
import { site } from "../../site";

const posts = await loadPosts();
---

<Base title="Sample posts" description="Example content from the starter posts collection.">
  <PageHeader
    title="Sample posts"
    description="These entries come from src/content/posts/. Edit them in Orso or replace the collection with your own model."
    back={{ label: "Back home", href: "/" }}
  />
  <div class="page mt-12 pb-section">
    {posts.length === 0 ? (
      <p class="text-muted">
        No posts yet. Add a Markdown file under <code class="text-ink">src/content/posts/</code> or read the{" "}
        <a class="link" href={site.docsUrl} rel="noopener noreferrer">docs</a>.
      </p>
    ) : (
      <ul class="divide-y divide-line border-y border-line">
        {posts.map((post) => (
          <li class="py-6">
            <a class="group block" href={`/posts/${post.id}/`}>
              <time class="label" datetime={post.data.date}>{formatDate(post.data.date)}</time>
              <h2 class="mt-2 text-2xl font-light tracking-display text-ink transition-colors duration-quick ease-gentle group-hover:text-accent">
                {post.data.title}
              </h2>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
