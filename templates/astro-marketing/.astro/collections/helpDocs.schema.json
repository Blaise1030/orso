{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "editor": {
        "type": "reference",
        "collection": "helpCategories"
      }
    },
    "category": {
      "type": "string",
      "editor": {
        "type": "reference",
        "collection": "helpDocsCategories"
      }
    },
    "subcategory": {
      "type": "string",
      "editor": {
        "type": "reference",
        "collection": "helpSubcategories"
      }
    },
    "order": {
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "section",
    "order"
  ]
}